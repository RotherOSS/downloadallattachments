#: ../content/index.rst:48
msgid "Autoloading of DownloadAttachment extensions."
msgstr "A mellékletek letöltése kiterjesztések automatikus betöltése."

#: ../content/index.rst:55
msgid "Frontend module registration for the agent interface."
msgstr "Előtétprogram-modul regisztráció az ügyintézői felülethez."

#: ../content/index.rst:62
msgid ""
"This configuration registers a link in the ticket menu to the ticket "
"overviews of the agent interface to download all ticket attachments."
msgstr ""
"Ez a beállítás regisztrál egy hivatkozást a jegymenüben az ügyintézői "
"felület jegyáttekintőihez az összes jegymelléklet letöltéséhez."

#: ../content/index.rst:69
msgid ""
"This configuration registers a link in the ticket menu to download all "
"ticket attachments."
msgstr ""
"Ez a beállítás regisztrál egy hivatkozást a jegymenüben az összes "
"jegymelléklet letöltéséhez."

